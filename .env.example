# ---- dottrader swarm configuration ----
# Copy to .env and fill in. NEVER commit .env.

# Base RPC. Public endpoint works but is rate limited; an Alchemy/QuickNode URL is better.
BASE_RPC_URL=https://mainnet.base.org

# The wallet THIS swarm process trades from (one process per trading wallet; use a different DATA_DIR for each).
WALLET_ADDRESS=0xcFCFc8e42AEBFC58AB78093217C2C4bB186BAc86
DATA_DIR=data

# Every wallet that counts toward the journey total (main holding wallet + trading wallets), comma separated.
TRACKED_WALLETS=0x8455cF296e1265b494605207e97884813De21950,0xcFCFc8e42AEBFC58AB78093217C2C4bB186BAc86,0x57C4e8C39d72540244FE8eDD302C7C463d6d545a

# Vault: earned DOT is swept here (the "ledger" wallet). Sweeps happen once SWEEP_MIN_DOT has accumulated.
VAULT_ADDRESS=0x8455cF296e1265b494605207e97884813De21950
SWEEP_MIN_DOT=1000
SWEEP_KEEP_DOT=0
# Optional: also sweep working inventory above this many DOT (leave unset to keep all inventory trading).
# SWEEP_INVENTORY_ABOVE_DOT=50000

# LIVE=0 -> paper trading (default). LIVE=1 -> real swaps are signed and broadcast.
LIVE=0

# Only needed when LIVE=1. Use a DEDICATED hot wallet holding just the trading sleeve.
# Never paste your main wallet's key anywhere, including chat.
PRIVATE_KEY=

# Accumulator budget: USD of ETH/USDC to convert into DOT per day (0 = off). The trading wallets hold ETH, so set this to start stacking.
DCA_USD_PER_DAY=5

# Loop interval in seconds
TICK_SECONDS=60

# Fraction of the wallet's starting DOT the swarm may trade (rest is untouchable core).
# Trading wallets start with 0 DOT, so everything they buy is working inventory; use 1.0 there. Use 0.30 if you ever run from the vault.
TRADING_SLEEVE=1.0

# Max slippage per swap, in percent
MAX_SLIPPAGE_PCT=1.0

# Minimum ETH to always keep for gas (live mode refuses to trade below this)
GAS_RESERVE_ETH=0.002

# Optional: KyberSwap client id header (any string)
KYBER_CLIENT_ID=dottrader
